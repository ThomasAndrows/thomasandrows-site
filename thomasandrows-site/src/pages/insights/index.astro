---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import FormScript from '../../components/FormScript.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../../data/site';
import { COMING_SOON } from '../../data/fieldnotes';
const posts = (await getCollection('insights', (p) => !p.data.draft)).sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const jsonLd = [
  { '@type': 'CollectionPage', url: `${SITE.url}/insights`, name: 'Insights', about: { '@id': `${SITE.url}/#person` } },
  { '@type': 'ItemList', itemListElement: posts.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: `${SITE.url}/insights/${p.id}`, name: p.data.title })) },
  { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' }, { '@type': 'ListItem', position: 2, name: 'Insights', item: SITE.url + '/insights' }] },
];
---
<BaseLayout title="Insights: GA4, GTM, BigQuery and AI Search Analytics" description="Weekly articles on web analytics by Thomas Androws: GA4, Google Tag Manager, server-side tagging, BigQuery, Consent Mode and measuring AI search visibility." path="/insights" jsonLd={jsonLd}>
  <section class="page-hero">
    <div class="wrap">
      <p class="eyebrow mono">Insights</p>
      <h1 class="h1" style="max-width: 900px;">New articles, every week.</h1>
      <p class="lead">Practical web analytics: how to collect clean data, model it and measure what matters, including in AI search.</p>
    </div>
  </section>
  <section class="sec sec-pad">
    <div class="bg-layer bg-rows deco" aria-hidden="true" style="-webkit-mask-image: linear-gradient(180deg, transparent 0%, transparent calc(100% - 90px), #000 100%); mask-image: linear-gradient(180deg, transparent 0%, transparent calc(100% - 90px), #000 100%);"></div>
    <div class="wrap">
      <div class="grid3">
        {posts.map((p) => (
          <a class="card reveal" href={`/insights/${p.id}`} style="padding: 0; overflow:hidden;">
            {p.data.image && <img src={p.data.image} alt={p.data.imageAlt ?? p.data.title} width="1200" height="630" loading="lazy" style="display:block;width:100%;height:auto;aspect-ratio:1200/630;object-fit:cover;">}
            <div style="padding: 28px;">
              <span class="chip">{p.data.category}</span>
              <h2 style="margin: 20px 0 0; font-size: 22px; font-weight: 700; line-height: 1.25; color: #fff;">{p.data.title}</h2>
              <p style="margin: 12px 0 0; font-size: 15px; line-height: 1.6; color: #aab6c2;">{p.data.description}</p>
              <p class="mono" style="margin: 16px 0 0; font-size: 12px; color: #8b98a5;">{fmt(p.data.publishDate)}</p>
            </div>
          </a>
        ))}
        {COMING_SOON.map((p) => (
          <div class="card soon" style="padding: 28px;">
            <span class="chip">{p.chip}</span>
            <h2 style="margin: 20px 0 0; font-size: 22px; font-weight: 700; line-height: 1.25; color: #fff;">{p.title}</h2>
            <p style="margin: 12px 0 0; font-size: 15px; line-height: 1.6; color: #aab6c2;">{p.blurb}</p>
            <p class="mono" style="margin: 14px 0 0; font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: #D4AF37;">Coming soon</p>
          </div>
        ))}
      </div>
      <div style="max-width: 560px; margin-top: 64px;"><NewsletterForm /></div>
    </div>
  </section>
  <FormScript />
</BaseLayout>
