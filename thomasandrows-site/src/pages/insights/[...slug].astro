---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import FormScript from '../../components/FormScript.astro';
import { getCollection, render } from 'astro:content';
import { SITE } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getCollection('insights', (p) => !p.data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const url = `${SITE.url}/insights/${post.id}`;
const image = d.image ?? '/og-default.png';
const words = (post.body ?? '').split(/\s+/).length;
const minutes = Math.max(3, Math.round(words / 220));
const fmt = (x: Date) => x.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const jsonLd: Record<string, unknown>[] = [
  {
    '@type': 'Article',
    '@id': `${url}#article`,
    headline: d.title,
    description: d.description,
    image: new URL(image, SITE.url).toString(),
    datePublished: d.publishDate.toISOString(),
    dateModified: (d.updatedDate ?? d.publishDate).toISOString(),
    author: { '@id': `${SITE.url}/#person` },
    publisher: { '@id': `${SITE.url}/#person` },
    mainEntityOfPage: { '@type': 'WebPage', '@id': url },
    articleSection: d.category,
    keywords: d.keywords.join(', '),
    inLanguage: 'en',
    wordCount: words,
  },
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' },
    { '@type': 'ListItem', position: 2, name: 'Insights', item: SITE.url + '/insights' },
    { '@type': 'ListItem', position: 3, name: d.title, item: url },
  ] },
];
if (d.faqs.length) jsonLd.push({ '@type': 'FAQPage', mainEntity: d.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) });
---
<BaseLayout title={d.title} description={d.description} path={`/insights/${post.id}`} image={image} type="article" publishedTime={d.publishDate.toISOString()} modifiedTime={(d.updatedDate ?? d.publishDate).toISOString()} jsonLd={jsonLd}>
  <section class="page-hero" style="padding: 72px 0 56px;">
    <div class="wrap" style="max-width: 900px;">
      <p class="crumbs"><a href="/">Home</a> / <a href="/insights">Insights</a> / {d.category}</p>
      <span class="chip">{d.category}</span>
      <h1 class="h1" style="margin-top: 20px; font-size: clamp(34px, 5vw, 60px);">{d.title}</h1>
      <p class="lead" style="margin-top: 20px;">{d.description}</p>
      <p class="mono" style="margin: 24px 0 0; font-size: 13px; color: #aab6c2;">By <a href="/about" style="color:#fff;text-decoration:none;font-weight:500;">{SITE.name}</a> &nbsp;/&nbsp; <time datetime={d.publishDate.toISOString()}>{fmt(d.publishDate)}</time>{d.updatedDate && <> &nbsp;/&nbsp; Updated <time datetime={d.updatedDate.toISOString()}>{fmt(d.updatedDate)}</time></>} &nbsp;/&nbsp; {minutes} min read</p>
    </div>
  </section>

  <article class="sec" style="padding: 56px 0 24px;">
    <div class="wrap">
      {d.image && (
        <div style="max-width: 1000px; margin: 0 auto 48px;">
          <img src={d.image} alt={d.imageAlt ?? d.title} width="1200" height="630" fetchpriority="high" style="display:block;width:100%;height:auto;border-radius:16px;border:1px solid #1c2630;">
        </div>
      )}
      <div class="prose">
        {d.answer && <div class="answer"><b class="mono">Short answer</b>{d.answer}</div>}
        <Content />
      </div>

      {d.faqs.length > 0 && (
        <div class="prose faq" style="margin-top: 56px;">
          <h2>Frequently asked questions</h2>
          {d.faqs.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      )}

      <div class="prose" style="margin-top: 56px;">
        <div class="card" style="padding: 28px; display:flex; gap:20px; align-items:center; flex-wrap:wrap;">
          <img src="/images/thomas-androws-portrait.webp" alt="Thomas Androws" width="72" height="72" loading="lazy" style="width:72px;height:72px;border-radius:50%;object-fit:cover;object-position:center top;">
          <div style="flex:1;min-width:220px;">
            <div style="font-size:18px;font-weight:700;color:#fff;">{SITE.name}</div>
            <p style="margin:6px 0 0;font-size:15px;line-height:1.6;color:#aab6c2;">Manager of Data Analytics (Brand and Web) at Freshworks. 12+ years across GA4, server-side GTM, BigQuery and AI search visibility. <a href="/about">More about me</a></p>
          </div>
        </div>
      </div>
      <div style="max-width: 760px; margin: 40px auto 0;"><NewsletterForm /></div>
    </div>
  </article>
  <FormScript />
</BaseLayout>
