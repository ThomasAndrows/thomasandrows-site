---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';
const faqs = [
  { q: 'Who is Thomas Androws?', a: 'Thomas Androws is a web analytics leader based in Chennai, India. He is Manager of Data Analytics (Brand and Web) at Freshworks and has 12+ years of experience across GA4, Google Tag Manager, server-side tagging, BigQuery and AI search visibility.' },
  { q: 'What certifications does Thomas Androws hold?', a: 'He is a CXL Certified Digital Analyst and holds an AI and ML certification from IIT Madras.' },
  { q: 'Which companies has Thomas worked with?', a: 'He has done analytics work for Freshworks, Ford, Whirlpool and Hush Puppies.' },
  { q: 'What tools does Thomas work with?', a: 'Google Analytics 4, Google Tag Manager including server-side, BigQuery, Looker Studio, Google Search Console and Vertex AI.' },
];
const jsonLd = [
  { '@type': 'ProfilePage', '@id': `${SITE.url}/about#profile`, url: `${SITE.url}/about`, name: 'About Thomas Androws', mainEntity: { '@id': `${SITE.url}/#person` }, isPartOf: { '@id': `${SITE.url}/#website` } },
  { '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' }, { '@type': 'ListItem', position: 2, name: 'About', item: SITE.url + '/about' }] },
];
---
<BaseLayout title="About Thomas Androws" description="Thomas Androws is Manager of Data Analytics (Brand and Web) at Freshworks with 12+ years across GA4, server-side GTM, BigQuery and AI search visibility. CXL Certified Digital Analyst." path="/about" type="profile" jsonLd={jsonLd}>
  <section class="page-hero">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow mono">About</p>
        <h1 class="h1">Twelve years of getting the numbers right.</h1>
        <p class="lead">I am Thomas Androws, Manager of Data Analytics (Brand and Web) at Freshworks, based in Chennai, India. I help teams collect data they can trust, model it properly and turn it into decisions.</p>
      </div>
      <div class="para-a">
        <div class="card" style="overflow: hidden; border-radius: 16px;">
          <img src="/images/thomas-androws-hero.webp" alt="Portrait of Thomas Androws, web analytics leader" width="1269" height="1240" style="display:block;width:100%;aspect-ratio:1/1;object-fit:cover;object-position:center top;" fetchpriority="high">
        </div>
      </div>
    </div>
  </section>

  <section class="sec sec-pad">
    <div class="bg-layer bg-dots deco" aria-hidden="true" style="-webkit-mask-image: radial-gradient(ellipse 35% 80% at 92% 20%, #000 0%, transparent 100%); mask-image: radial-gradient(ellipse 35% 80% at 92% 20%, #000 0%, transparent 100%);"></div>
    <div class="wrap" style="max-width: 860px;">
      <div class="answer"><b class="mono">Short answer</b>Thomas Androws is a web analytics leader with 12+ years of experience. He leads web and brand analytics at Freshworks and specialises in GA4, Google Tag Manager (including server-side), BigQuery, Looker Studio, Search Console and AI search visibility.</div>
      <div class="prose" style="margin: 0;">
        <h2>What I do</h2>
        <p>At Freshworks I lead analytics for the brand and web side of the business. That means making sure the data behind websites, campaigns and content is collected correctly, consented properly, modeled in BigQuery and reported in a way that supports real decisions.</p>
        <p>Before Freshworks, I spent years in enterprise analytics for global brands, including Ford, Whirlpool and Hush Puppies. That work taught me how measurement behaves at scale: many teams, many tags and many ways for numbers to quietly drift.</p>
        <h2>How I think about measurement</h2>
        <ul>
          <li><strong>Every number must be explainable.</strong> If you cannot trace a metric back to the event that produced it, you should not trust it.</li>
          <li><strong>Design the data layer first.</strong> Tags are easy. A well designed data layer is what keeps tracking stable for years.</li>
          <li><strong>Consent is part of the architecture.</strong> It starts at the banner, not at the end.</li>
          <li><strong>Search is changing.</strong> Measuring AI search visibility is now part of web analytics.</li>
        </ul>
        <h2>Credentials</h2>
        <ul>
          <li>CXL Certified Digital Analyst</li>
          <li>AI and ML certification, IIT Madras</li>
          <li>12+ years in digital analytics</li>
        </ul>
        <h2>Tools I work with</h2>
        <p>Google Analytics 4, Google Tag Manager and server-side tagging, BigQuery, Looker Studio, Google Search Console, Consent Mode and Vertex AI.</p>
        <h2>Writing and community</h2>
        <p>I write weekly in <a href="/insights">Insights</a> about what I learn, and I enjoy meeting the people behind the tools. See the <a href="/field-notes">Field Notes</a> for conferences and meetups, from brightonSEO to a conversation with Krista Seiden.</p>
      </div>
      <p style="margin-top: 32px;"><a class="btn-primary" href="/contact">Get in touch</a></p>
    </div>
  </section>

  <section class="sec sec-pad" style="background: #0a0e12; border-top: 1px solid #1c2630; border-bottom: 1px solid #1c2630;">
    <div class="wrap" style="max-width: 860px;">
      <p class="eyebrow mono" style="color:#fff;">FAQ</p>
      <h2 class="h2">Quick answers about me.</h2>
      <div class="faq" style="margin-top: 32px;">
        {faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p style="color:#e6edf3;">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
