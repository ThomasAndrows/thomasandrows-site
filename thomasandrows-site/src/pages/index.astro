---
import StackVisual from '../components/StackVisual.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import DirectCard from '../components/DirectCard.astro';
import FormScript from '../components/FormScript.astro';
import { getCollection } from 'astro:content';
import { SITE, TOOLS } from '../data/site';
import { FIELD_NOTES, COMING_SOON, EXPERTISE } from '../data/fieldnotes';

const posts = (await getCollection('insights', (p) => !p.data.draft)).sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
const latest = posts.slice(0, 3);
const soon = COMING_SOON.slice(0, Math.max(0, 3 - latest.length));
---
<BaseLayout title={SITE.title} description={SITE.description} path="/" jsonLd={[{ '@type': 'WebPage', '@id': `${SITE.url}/#webpage`, url: SITE.url, name: SITE.title, isPartOf: { '@id': `${SITE.url}/#website` }, about: { '@id': `${SITE.url}/#person` } }]}>
<section class="sec" style="padding: 96px 0 72px; overflow: hidden; ">
<div class="bg-layer bg-grid bg-par deco" aria-hidden="true" style="-webkit-mask-image: radial-gradient(ellipse 40% 78% at 84% 45%, #000 0%, transparent 100%); mask-image: radial-gradient(ellipse 40% 78% at 84% 45%, #000 0%, transparent 100%);"></div>
<svg class="bg-layer bg-par deco" viewBox="0 0 1440 760" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false" style="width: 100%; height: 100%; -webkit-mask-image: linear-gradient(90deg, transparent 0%, transparent 50%, #000 58%); mask-image: linear-gradient(90deg, transparent 0%, transparent 50%, #000 58%);">
<defs>
<linearGradient id="heroFill" x1="0" y1="0" x2="0" y2="1">
<stop offset="0" stop-color="#D4AF37" stop-opacity="0.16"></stop>
<stop offset="1" stop-color="#D4AF37" stop-opacity="0"></stop>
</linearGradient>
</defs>
<path d="M640 745 C 900 745, 1100 735, 1250 700 S 1400 600, 1380 420 S 1420 200, 1500 120 L 1500 760 L 640 760 Z" fill="url(#heroFill)"></path>
<path class="ln-dash" d="M640 720 C 860 700, 1000 740, 1250 690 S 1420 560, 1500 520" fill="none" stroke="#8b98a5" stroke-opacity="0.4" stroke-width="1.2"></path>
<path class="ln-dash-r" d="M700 40 C 900 70, 1100 20, 1300 60 S 1440 40, 1500 80" fill="none" stroke="#8b98a5" stroke-opacity="0.4" stroke-width="1.2"></path>
<path class="ln-dash" d="M640 760 C 900 750, 1200 760, 1500 700" fill="none" stroke="#8b98a5" stroke-opacity="0.28" stroke-width="1"></path>
<path class="ln-draw" pathLength="1" d="M640 745 C 900 745, 1100 735, 1250 700 S 1400 600, 1380 420 S 1420 200, 1500 120" fill="none" stroke="#D4AF37" stroke-width="2.5" stroke-linecap="round"></path>
<circle cx="1250" cy="700" r="4" fill="#D4AF37"></circle>
<circle class="ping" cx="1250" cy="700" r="4" fill="none" stroke="#D4AF37" stroke-width="1.5"></circle>
<circle cx="1380" cy="420" r="4" fill="#D4AF37"></circle>
<circle class="ping" style="animation-delay: -1.5s;" cx="1380" cy="420" r="4" fill="none" stroke="#D4AF37" stroke-width="1.5"></circle>
</svg>
<div class="wrap hero-grid">
<div>
<p class="mono" style="margin: 0 0 24px; font-size: 13px; letter-spacing: 0.14em; text-transform: uppercase; color: #D4AF37;">Web analytics / Chennai, India</p>
<h1 style="margin: 0; font-size: clamp(44px, 6.4vw, 92px); font-weight: 900; line-height: 1.02; letter-spacing: -0.03em; color: #ffffff;">I make web analytics <span style="color: #D4AF37;">trustworthy.</span></h1>
<p style="margin: 28px 0 0; font-size: 20px; line-height: 1.55; color: #aab6c2; max-width: 560px;">Thomas Androws. Manager of Data Analytics (Brand and Web) at Freshworks. 12+ years across GA4, server-side GTM, BigQuery and AI search visibility.</p>
<div style="margin-top: 36px; display: flex; gap: 16px; flex-wrap: wrap;">
<a class="btn-primary" href="/expertise">See my expertise</a>
<a class="btn-ghost" href="/insights">Read the insights</a>
</div>
<p class="mono" style="margin: 32px 0 0; font-size: 13px; color: #8b98a5;">CXL Certified Digital Analyst &nbsp;/&nbsp; AI and ML Certified, IIT Madras</p>
<ul aria-label="Tools I work with" style="list-style: none; margin: 20px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px;">
{TOOLS.map((t) => <li class="tool"><img class="tool-logo" src={t.logo} alt="" width="28" height="28" loading="eager">{t.name}</li>)}
</ul>
</div>
<div class="para-a">
<div class="card" style="overflow: hidden; border-radius: 16px;">
<div class="mono" style="display: flex; justify-content: space-between; padding: 12px 16px; border-bottom: 1px solid #1c2630; font-size: 12px; color: #8b98a5;">
<span>~/thomas $ whoami</span>
<span style="color: #D4AF37;">GA4 / GTM / BigQuery</span>
</div>
<img src="/images/thomas-androws-hero.webp" width="1254" height="1254" fetchpriority="high" alt="Portrait of Thomas Androws, Manager of Data Analytics at Freshworks" style="display: block; width: 100%; aspect-ratio: 1 / 1; object-fit: cover; object-position: center top;">
</div>
</div>
</div>
</section>
<div class="glow-line" aria-hidden="true"></div>
<div class="glow-line" aria-hidden="true"></div>

<!-- DATA FLOW -->
<section class="sec" style="padding: 56px 0 88px;" aria-labelledby="flow-title">
<div class="bg-layer bg-dots deco" aria-hidden="true" style="-webkit-mask-image: radial-gradient(ellipse 35% 80% at 92% 20%, #000 0%, transparent 100%); mask-image: radial-gradient(ellipse 35% 80% at 92% 20%, #000 0%, transparent 100%);"></div>
<div class="wrap">
<p class="mono" style="margin: 0 0 12px; font-size: 13px; letter-spacing: 0.14em; text-transform: uppercase; color: #8b98a5;">Data flow</p>
<h2 id="flow-title" style="margin: 0 0 36px; font-size: 32px; font-weight: 700; letter-spacing: -0.01em; color: #ffffff;">From click to decision.</h2>
<div class="pipe reveal">
<div class="pipe-node"><div class="mono" style="font-size: 12px; color: #D4AF37;">01</div><div style="font-weight: 700; margin-top: 4px;">Site and app</div><div style="font-size: 13px; color: #8b98a5; margin-top: 2px;">Data layer</div></div>
<div class="pipe-link"></div>
<div class="pipe-node"><div class="mono" style="font-size: 12px; color: #D4AF37;">02</div><div style="font-weight: 700; margin-top: 4px;">GTM web</div><div style="font-size: 13px; color: #8b98a5; margin-top: 2px;">Tags and triggers</div></div>
<div class="pipe-link"></div>
<div class="pipe-node"><div class="mono" style="font-size: 12px; color: #D4AF37;">03</div><div style="font-weight: 700; margin-top: 4px;">Server-side GTM</div><div style="font-size: 13px; color: #8b98a5; margin-top: 2px;">Control and clean-up</div></div>
<div class="pipe-link"></div>
<div class="pipe-node"><div class="mono" style="font-size: 12px; color: #D4AF37;">04</div><div style="font-weight: 700; margin-top: 4px;">GA4</div><div style="font-size: 13px; color: #8b98a5; margin-top: 2px;">Events and key events</div></div>
<div class="pipe-link"></div>
<div class="pipe-node"><div class="mono" style="font-size: 12px; color: #D4AF37;">05</div><div style="font-weight: 700; margin-top: 4px;">BigQuery</div><div style="font-size: 13px; color: #8b98a5; margin-top: 2px;">Models and SQL</div></div>
<div class="pipe-link"></div>
<div class="pipe-node"><div class="mono" style="font-size: 12px; color: #D4AF37;">06</div><div style="font-weight: 700; margin-top: 4px;">Looker Studio</div><div style="font-size: 13px; color: #8b98a5; margin-top: 2px;">Decisions</div></div>
</div>
</div>
</section>
<section id="about" class="sec" style="padding: 88px 0; border-top: 0; border-bottom: 0; background: #0a0e12; border-top: 1px solid #1c2630; border-bottom: 1px solid #1c2630; overflow: hidden;">
<div class="bg-layer bg-diag deco" aria-hidden="true" style="-webkit-mask-image: linear-gradient(270deg, #000 0%, transparent 28%); mask-image: linear-gradient(270deg, #000 0%, transparent 28%);"></div>
<svg class="deco" aria-hidden="true" focusable="false" viewBox="0 0 640 640" style="position: absolute; right: -240px; top: -240px; width: 640px; height: 640px; pointer-events: none;">
<circle cx="320" cy="320" r="120" fill="none" stroke="#D4AF37" stroke-opacity="0.28" stroke-width="1.5"></circle>
<circle class="spin" cx="320" cy="320" r="200" fill="none" stroke="#D4AF37" stroke-opacity="0.45" stroke-width="3" stroke-dasharray="2 14" stroke-linecap="round"></circle>
<circle class="spin-r" cx="320" cy="320" r="270" fill="none" stroke="#8b98a5" stroke-opacity="0.5" stroke-width="2" stroke-dasharray="1 18" stroke-linecap="round"></circle>
<circle cx="320" cy="320" r="312" fill="none" stroke="#8b98a5" stroke-opacity="0.18" stroke-width="1"></circle>
</svg>
<div class="wrap">
<p class="mono" style="margin: 0 0 12px; font-size: 13px; letter-spacing: 0.14em; text-transform: uppercase; color: #8b98a5;">About</p>
<h2 class="reveal" style="margin: 0; max-width: 880px; font-size: clamp(32px, 4.4vw, 56px); font-weight: 900; line-height: 1.08; letter-spacing: -0.025em; color: #ffffff;">Twelve years of getting the numbers right.</h2>
<p class="reveal" style="margin: 24px 0 0; max-width: 720px; font-size: 19px; line-height: 1.65; color: #aab6c2;">I lead web and brand analytics at Freshworks. Before that I spent years in enterprise analytics for global brands. I am a CXL Certified Digital Analyst and hold an AI and ML certification from IIT Madras, and I write about what I learn so other teams can skip the expensive mistakes.</p>
<p style="margin: 20px 0 0;"><a href="/about" style="font-weight: 500; text-decoration: none;">More about me &rarr;</a></p>

<div style="margin-top: 64px;">
<p class="mono" style="margin: 0 0 20px; font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: #8b98a5;">Analytics work for</p>
<ul style="list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 16px 56px; align-items: baseline;">
<li style="font-size: 28px; font-weight: 700; letter-spacing: -0.01em; color: #c3ced8;">Freshworks</li>
<li style="font-size: 28px; font-weight: 700; letter-spacing: -0.01em; color: #c3ced8;">Ford</li>
<li style="font-size: 28px; font-weight: 700; letter-spacing: -0.01em; color: #c3ced8;">Whirlpool</li>
<li style="font-size: 28px; font-weight: 700; letter-spacing: -0.01em; color: #c3ced8;">Hush Puppies</li>
</ul>
</div>

<div class="grid3" style="margin-top: 64px; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));">
<div class="card" style="padding: 28px;">
<div style="font-size: 64px; font-weight: 900; line-height: 1; color: #D4AF37; letter-spacing: -0.03em;"><span class="count12"></span></div>
<div style="margin-top: 12px; font-size: 16px; color: #aab6c2;">years in digital analytics</div>
</div>
<div class="card" style="padding: 28px;">
<div style="font-size: 64px; font-weight: 900; line-height: 1; color: #D4AF37; letter-spacing: -0.03em;">CXL</div>
<div style="margin-top: 12px; font-size: 16px; color: #aab6c2;">Certified Digital Analyst</div>
</div>
<div class="card" style="padding: 28px;">
<div style="font-size: 64px; font-weight: 900; line-height: 1; color: #D4AF37; letter-spacing: -0.03em;">AI/ML</div>
<div style="margin-top: 12px; font-size: 16px; color: #aab6c2;">Certified, IIT Madras</div>
</div>
<div class="card" style="padding: 28px;">
<div style="font-size: 64px; font-weight: 900; line-height: 1; color: #D4AF37; letter-spacing: -0.03em;"><span class="count6"></span></div>
<div style="margin-top: 12px; font-size: 16px; color: #aab6c2;">core tools: GA4, GTM, BigQuery, Looker Studio, Search Console, Vertex AI</div>
</div>
</div>
</div>
</section>
<section class="sec" style="padding: 120px 0;" aria-labelledby="stack-title">
<div class="bg-layer bg-cols deco" aria-hidden="true" style="-webkit-mask-image: linear-gradient(90deg, #000 0%, #000 7%, transparent 9%, transparent 91%, #000 93%, #000 100%); mask-image: linear-gradient(90deg, #000 0%, #000 7%, transparent 9%, transparent 91%, #000 93%, #000 100%);"></div>
<div class="stream-v deco" aria-hidden="true" style="left: 24px;"></div>
<div class="stream-v deco" aria-hidden="true" style="right: 24px;"></div>
<div class="wrap">
<div style="max-width: 760px;">
<p class="mono" style="margin: 0 0 12px; font-size: 13px; letter-spacing: 0.14em; text-transform: uppercase; color: #D4AF37;">The measurement stack</p>
<h2 id="stack-title" style="margin: 0; font-size: clamp(34px, 4.2vw, 56px); font-weight: 900; line-height: 1.05; letter-spacing: -0.025em; color: #ffffff;">From raw clicks to answers you can act on.</h2>
<p style="margin: 24px 0 0; font-size: 18px; line-height: 1.6; color: #aab6c2;">One principle: every number should be explainable back to the event that produced it. This is the path a visit takes, from consent to the dashboard.</p>
</div>
<div class="flow-wrap">
<div class="stages" aria-hidden="true">
<div class="stage st1"><span class="mono">01</span><b>Collect</b><p>Clean data layers, GTM and server-side tagging, so what you collect is accurate, consented and under your control.</p></div>
<div class="stage st2"><span class="mono">02</span><b>Model</b><p>Event design, GA4 and BigQuery exports, shaped into models the whole team can query.</p></div>
<div class="stage st3"><span class="mono">03</span><b>Report</b><p>Looker Studio dashboards built around the decisions people actually make.</p></div>
<div class="stage st4"><span class="mono">04</span><b>Be found</b><p>Search Console and AI search visibility, so you know how you show up.</p></div>
</div>
<div class="flow-scroll"><div class="flow" role="img" aria-label="Measurement architecture in four stages. Collect: your website, cookie consent, Google Tag Manager, Consent Mode v2, Hotjar, Microsoft Clarity and server-side GTM on Google Cloud Run. Model: Google Analytics 4, Google Ads, Meta Conversions API, Microsoft Advertising and BigQuery. Report: BigQuery and Looker Studio. Be found: Search Console.">
<div class="flow-col" style="--c:0"><div class="flow-h mono">Visitor</div><div class="flow-stack">
<div class="fn s1"><span class="ico gen"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="#D4AF37" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/></svg></span><div><b>Your website</b><span>Visitor browser</span></div></div>
<div class="fn s1"><span class="ico gen"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="#D4AF37" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-9-9 4 4 0 0 0 5 5 3 3 0 0 0 4 4z"/><circle cx="9" cy="10" r=".6" fill="#D4AF37"/><circle cx="14" cy="15" r=".6" fill="#D4AF37"/><circle cx="8.5" cy="15" r=".6" fill="#D4AF37"/></svg></span><div><b>Cookie consent</b><span>Banner and CMP</span></div></div>
</div></div>
<div class="flow-link" style="--c:0"><i></i></div>
<div class="flow-col" style="--c:1"><div class="flow-h mono">Web container</div><div class="flow-stack">
<div class="fn s1"><span class="ico"><img src="/logos/google-tag-manager.png" alt="" width="28" height="28"></span><div><b>Google Tag Manager</b><span>Web container</span></div></div>
<div class="fn s1"><span class="ico gen"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="#D4AF37" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 3v6c0 4.5-3.2 8-8 9-4.8-1-8-4.5-8-9V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/></svg></span><div><b>Consent Mode v2</b><span>Signals follow choices</span></div></div>
<div class="fn s1"><span class="ico"><img src="/logos/arch/hotjar.png" alt="" width="28" height="28"></span><div><b>Hotjar</b><span>Behavior analytics</span></div></div>
<div class="fn s1"><span class="ico"><img src="/logos/arch/clarity.png" alt="" width="28" height="28"></span><div><b>Microsoft Clarity</b><span>Session replays</span></div></div>
</div></div>
<div class="flow-link" style="--c:1"><i></i></div>
<div class="flow-col" style="--c:2"><div class="flow-h mono">Your server</div><div class="flow-stack" style="justify-content:center;">
<div class="fn s1"><span class="ico"><img src="/logos/arch/cloudrun.png" alt="" width="28" height="28"></span><div><b>Server-side GTM</b><span>Google Cloud Run</span></div></div>
</div></div>
<div class="flow-link" style="--c:2"><i></i></div>
<div class="flow-col" style="--c:3"><div class="flow-h mono">Destinations</div><div class="flow-stack">
<div class="fn s2"><span class="ico"><img src="/logos/google-analytics-4.png" alt="" width="28" height="28"></span><div><b>Google Analytics 4</b><span>Events and conversions</span></div></div>
<div class="fn s2"><span class="ico"><img src="/logos/arch/google-ads.png" alt="" width="28" height="28"></span><div><b>Google Ads</b><span>Conversion matching</span></div></div>
<div class="fn s2"><span class="ico"><img src="/logos/arch/meta.png" alt="" width="28" height="28"></span><div><b>Meta Conversions API</b><span>Server events</span></div></div>
<div class="fn s2"><span class="ico"><img src="/logos/arch/bing.png" alt="" width="28" height="28"></span><div><b>Microsoft Advertising</b><span>UET and conversions</span></div></div>
</div></div>
<div class="flow-link" style="--c:3"><i></i></div>
<div class="flow-col" style="--c:4"><div class="flow-h mono">Warehouse and reports</div><div class="flow-stack">
<div class="fn s2 s3"><span class="ico"><img src="/logos/bigquery.png" alt="" width="28" height="28"></span><div><b>BigQuery</b><span>Your Google Cloud</span></div></div>
<div class="fn s3"><span class="ico"><img src="/logos/looker-studio.png" alt="" width="28" height="28"></span><div><b>Looker Studio</b><span>Dashboards and alerts</span></div></div>
<div class="fn s4"><span class="ico"><img src="/logos/search-console.png" alt="" width="28" height="28"></span><div><b>Search Console</b><span>Organic and AI visibility</span></div></div>
</div></div>
</div></div>
</div>
</div>
</section>
<div class="glow-line" aria-hidden="true"></div>
<section id="expertise" class="sec" style="padding: 96px 0; background: #0a0e12; border-top: 1px solid #1c2630; border-bottom: 1px solid #1c2630; border-bottom: 0; overflow: hidden;" aria-labelledby="exp-title">
<div class="bg-layer bg-dots deco" aria-hidden="true" style="-webkit-mask-image: radial-gradient(ellipse 35% 70% at 92% 18%, #000 0%, transparent 100%); mask-image: radial-gradient(ellipse 35% 70% at 92% 18%, #000 0%, transparent 100%);"></div>
<div class="wrap">
<p class="mono" style="margin: 0 0 12px; font-size: 13px; letter-spacing: 0.14em; text-transform: uppercase; color: #D4AF37;">Expertise</p>
<h2 id="exp-title" class="reveal" style="margin: 0 0 48px; max-width: 760px; font-size: clamp(32px, 4.2vw, 52px); font-weight: 900; line-height: 1.08; letter-spacing: -0.025em; color: #ffffff;">What I work on.</h2>
<div class="grid3">
{EXPERTISE.map((e) => (
<a class="card reveal" href={`/expertise#${e.id}`} style="padding: 28px;">
<h3 style="margin: 0; font-size: 22px; font-weight: 700; color: #ffffff;">{e.title}</h3>
<p style="margin: 12px 0 0; font-size: 16px; line-height: 1.6; color: #aab6c2;">{e.blurb}</p>
</a>
))}
</div>
<p style="margin: 36px 0 0;"><a href="/expertise" style="font-weight: 500; text-decoration: none;">All expertise &rarr;</a></p>
</div>
</section>
<section id="field-notes" class="sec" style="padding: 120px 0 140px; overflow: hidden;" aria-labelledby="field-title">
<svg class="wave-a deco" aria-hidden="true" focusable="false" viewBox="0 0 2880 300" preserveAspectRatio="none" style="position: absolute; left: 0; bottom: -40px; width: 200%; height: 240px; pointer-events: none;">
<path d="M0 150 Q 180 40 360 150 T 720 150 T 1080 150 T 1440 150 T 1800 150 T 2160 150 T 2520 150 T 2880 150" fill="none" stroke="#D4AF37" stroke-opacity="0.25" stroke-width="1.5" vector-effect="non-scaling-stroke"></path>
</svg>
<svg class="wave-b deco" aria-hidden="true" focusable="false" viewBox="0 0 2880 300" preserveAspectRatio="none" style="position: absolute; left: 0; bottom: -60px; width: 200%; height: 240px; pointer-events: none;">
<path d="M0 150 Q 180 95 360 150 T 720 150 T 1080 150 T 1440 150 T 1800 150 T 2160 150 T 2520 150 T 2880 150" fill="none" stroke="#8b98a5" stroke-opacity="0.3" stroke-width="1.2" vector-effect="non-scaling-stroke"></path>
</svg>
<svg class="wave-c deco" aria-hidden="true" focusable="false" viewBox="0 0 2880 300" preserveAspectRatio="none" style="position: absolute; left: 0; bottom: -20px; width: 200%; height: 240px; pointer-events: none;">
<path d="M0 150 Q 180 -10 360 150 T 720 150 T 1080 150 T 1440 150 T 1800 150 T 2160 150 T 2520 150 T 2880 150" fill="none" stroke="#D4AF37" stroke-opacity="0.12" stroke-width="1" vector-effect="non-scaling-stroke"></path>
</svg>
<div class="wrap">
<p class="mono" style="margin: 0 0 12px; font-size: 13px; letter-spacing: 0.14em; text-transform: uppercase; color: #D4AF37;">Field notes</p>
<h2 id="field-title" class="reveal" style="margin: 0; max-width: 820px; font-size: clamp(32px, 4.2vw, 52px); font-weight: 900; line-height: 1.08; letter-spacing: -0.025em; color: #ffffff;">Conferences, communities and the people who shaped how I measure.</h2>
<div class="grid4" style="margin-top: 64px;">
{FIELD_NOTES.map((f, i) => (
<figure class={i % 2 === 0 ? 'para-a' : 'para-b'} style="margin: 0;">
<div class="card" style="overflow: hidden;">
<img src={f.img} alt={f.alt} width={f.width} height={f.height} loading="lazy" style={`display: block; width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: ${f.pos};`}>
<figcaption style="padding: 18px;">
<div class="mono" style="font-size: 12px; color: #D4AF37;">{f.meta}</div>
<div style="margin-top: 6px; font-size: 18px; font-weight: 700; color: #ffffff;">{f.title}</div>
<p style="margin: 8px 0 0; font-size: 14px; line-height: 1.55; color: #8b98a5;">{f.short}</p>
</figcaption>
</div>
</figure>
))}
</div>
<p style="margin: 40px 0 0;"><a href="/field-notes" style="font-weight: 500; text-decoration: none;">All field notes &rarr;</a></p>
</div>
</section>
<section id="insights" class="sec" style="padding: 96px 0; background: #0a0e12; border-top: 1px solid #1c2630; border-bottom: 1px solid #1c2630; border-top: 0; border-bottom: 0; overflow: hidden;" aria-labelledby="insights-title">
