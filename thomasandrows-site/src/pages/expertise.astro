---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';
import { EXPERTISE } from '../data/fieldnotes';
const faqs = [
  { q: 'What is the first step in a GA4 implementation?', a: 'Define the measurement plan and design the data layer before you tag anything. Tags are easy to change later, but a weak data layer forces you to re-tag the whole site.' },
  { q: 'When is server-side GTM worth it?', a: 'When you need more control over what data is sent to vendors, want to improve data quality and governance, or have a clear business case that justifies the extra hosting cost and complexity. For many smaller sites a well built web container is enough.' },
  { q: 'Why export GA4 data to BigQuery?', a: 'The BigQuery export gives you raw event data that is not sampled and can be joined with other sources such as CRM data. It lets you build documented models that dashboards and analysts can trust.' },
  { q: 'Can you track traffic from AI assistants like ChatGPT or Perplexity?', a: 'Partly. Referral traffic from AI assistants can be grouped in GA4 using a channel group or regex on the source, and Search Console covers Google search. Impressions inside AI answers are not fully measurable yet.' },
];
const jsonLd = [
  { '@type': 'CollectionPage', '@id': `${SITE.url}/expertise#page`, url: `${SITE.url}/expertise`, name: 'Web analytics expertise', about: { '@id': `${SITE.url}/#person` } },
  { '@type': 'ItemList', name: 'Web analytics expertise areas', itemListElement: EXPERTISE.map((e, i) => ({ '@type': 'ListItem', position: i + 1, name: e.title, url: `${SITE.url}/expertise#${e.id}` })) },
  { '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' }, { '@type': 'ListItem', position: 2, name: 'Expertise', item: SITE.url + '/expertise' }] },
];
---
<BaseLayout title="Web Analytics Expertise: GA4, Server-side GTM, BigQuery" description="Expertise in GA4 implementation and audits, server-side GTM, BigQuery data modeling, Looker Studio reporting, Search Console and AI search visibility analytics." path="/expertise" jsonLd={jsonLd}>
  <section class="page-hero">
    <div class="wrap">
      <p class="eyebrow mono">Expertise</p>
      <h1 class="h1" style="max-width: 900px;">What I work on.</h1>
      <p class="lead">Six areas of web analytics, from collecting clean data to reporting it and measuring how your brand shows up in search and AI answers.</p>
    </div>
  </section>

  <section class="sec sec-pad">
    <div class="bg-layer bg-cols deco" aria-hidden="true" style="-webkit-mask-image: linear-gradient(90deg, #000 0%, #000 7%, transparent 9%, transparent 91%, #000 93%, #000 100%); mask-image: linear-gradient(90deg, #000 0%, #000 7%, transparent 9%, transparent 91%, #000 93%, #000 100%);"></div>
    <div class="wrap" style="display:flex;flex-direction:column;gap:28px;">
      {EXPERTISE.map((e, i) => (
        <article class="card reveal" id={e.id} style="padding: 36px; scroll-margin-top: 96px;">
          <div class="mono" style="font-size: 48px; font-weight: 500; line-height: 1; color: #D4AF37;">{String(i + 1).padStart(2, '0')}</div>
          <h2 style="margin: 16px 0 0; font-size: 30px; font-weight: 700; letter-spacing: -0.01em; color: #fff;">{e.title}</h2>
          <p style="margin: 14px 0 0; font-size: 18px; line-height: 1.65; color: #aab6c2; max-width: 780px;">{e.detail}</p>
          <ul style="margin: 20px 0 0; padding-left: 20px; color: #c3ced8; line-height: 1.8;">
            {e.points.map((p) => <li>{p}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section class="sec sec-pad" style="background: #0a0e12; border-top: 1px solid #1c2630; border-bottom: 1px solid #1c2630;">
    <div class="wrap" style="max-width: 860px;">
      <p class="eyebrow mono" style="color:#fff;">FAQ</p>
      <h2 class="h2">Common questions.</h2>
      <div class="faq" style="margin-top: 32px;">
        {faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p style="color:#e6edf3;">{f.a}</p>
          </details>
        ))}
      </div>
      <p style="margin-top: 36px;"><a class="btn-primary" href="/contact">Talk about your measurement</a></p>
    </div>
  </section>
</BaseLayout>
