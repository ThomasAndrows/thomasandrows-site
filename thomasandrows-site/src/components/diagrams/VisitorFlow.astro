---
---
<figure class="diagram">
  <svg viewBox="0 0 900 470" role="img" aria-labelledby="vf-t vf-d" font-family="Roboto, system-ui, sans-serif">
    <title id="vf-t">Tracking architecture: from visitor to GA4</title>
    <desc id="vf-d">A visitor lands on the site and sees a cookie consent banner. After they accept or reject, the consent state goes into the data layer. Google Tag Manager reads the data layer and fires GA4, marketing tags and server-side tagging. The web team and enrichment tools push values into the data layer.</desc>
    <defs>
      <marker id="vf-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 z" fill="#D4AF37"/></marker>
    </defs>

    <!-- connectors -->
    <g fill="none" stroke="#D4AF37" stroke-width="2" marker-end="url(#vf-arrow)" stroke-linecap="round">
      <path class="d-flow" d="M128 230 H172"/>
      <path class="d-flow" d="M328 230 H372"/>
      <path class="d-flow" d="M528 230 H572"/>
      <path class="d-flow" d="M708 230 C 730 230, 730 130, 752 130"/>
      <path class="d-flow" d="M708 230 H752"/>
      <path class="d-flow" d="M708 230 C 730 230, 730 330, 752 330"/>
      <path class="d-flow" d="M451 88 V 166"/>
      <path class="d-flow" d="M451 372 V 294"/>
    </g>

    <!-- moving data dot -->
    <circle r="5" fill="#fff">
      <animateMotion dur="5s" repeatCount="indefinite" path="M128 230 H 708 C 730 230, 730 230, 752 230"/>
    </circle>

    <!-- visitor -->
    <g>
      <rect x="16" y="188" width="110" height="84" rx="12" fill="#0e1318" stroke="#2a3744"/>
      <circle cx="71" cy="214" r="9" fill="none" stroke="#aab6c2" stroke-width="2"/>
      <path d="M53 246 C 55 232, 87 232, 89 246" fill="none" stroke="#aab6c2" stroke-width="2" stroke-linecap="round"/>
      <text x="71" y="262" text-anchor="middle" font-size="13" font-weight="700" fill="#fff">Visitor</text>
    </g>

    <!-- consent banner -->
    <g>
      <rect x="176" y="168" width="150" height="124" rx="12" fill="#0e1318" stroke="#D4AF37" stroke-opacity="0.6"/>
      <text x="251" y="194" text-anchor="middle" font-size="13" font-weight="700" fill="#fff">Cookie consent</text>
      <rect x="192" y="208" width="54" height="26" rx="13" fill="#D4AF37"/>
      <text x="219" y="226" text-anchor="middle" font-size="12" font-weight="700" fill="#07090c">Accept</text>
      <rect x="256" y="208" width="54" height="26" rx="13" fill="none" stroke="#aab6c2"/>
      <text x="283" y="226" text-anchor="middle" font-size="12" font-weight="500" fill="#e6edf3">Reject</text>
      <text x="251" y="262" text-anchor="middle" font-size="11.5" fill="#8b98a5">Either choice is</text>
      <text x="251" y="278" text-anchor="middle" font-size="11.5" fill="#8b98a5">a consent signal</text>
    </g>

    <!-- data layer -->
    <g>
      <rect class="d-pulse" x="376" y="168" width="150" height="124" rx="12" fill="#0e1318" stroke="#D4AF37"/>
      <text x="451" y="194" text-anchor="middle" font-size="13" font-weight="700" fill="#fff">dataLayer</text>
      <text x="451" y="218" text-anchor="middle" font-size="12" fill="#D4AF37">1 consent default</text>
      <text x="451" y="238" text-anchor="middle" font-size="12" fill="#D4AF37">2 consent update</text>
      <text x="451" y="258" text-anchor="middle" font-size="12" fill="#c3ced8">3 events and values</text>
      <text x="451" y="278" text-anchor="middle" font-size="11.5" fill="#8b98a5">the single source of truth</text>
    </g>

    <!-- GTM -->
    <g>
      <rect x="576" y="168" width="130" height="124" rx="12" fill="#0e1318" stroke="#2a3744"/>
      <text x="641" y="194" text-anchor="middle" font-size="13" font-weight="700" fill="#fff">Google Tag</text>
      <text x="641" y="210" text-anchor="middle" font-size="13" font-weight="700" fill="#fff">Manager</text>
      <text x="641" y="236" text-anchor="middle" font-size="11.5" fill="#aab6c2">Consent Initialization</text>
      <text x="641" y="254" text-anchor="middle" font-size="11.5" fill="#aab6c2">Triggers</text>
      <text x="641" y="272" text-anchor="middle" font-size="11.5" fill="#aab6c2">Tags</text>
    </g>

    <!-- destinations -->
    <g>
      <rect x="756" y="95" width="130" height="70" rx="12" fill="#0e1318" stroke="#2a3744"/>
      <text x="821" y="125" text-anchor="middle" font-size="13" font-weight="700" fill="#fff">GA4</text>
      <text x="821" y="145" text-anchor="middle" font-size="11.5" fill="#8b98a5">events and key events</text>
      <rect x="756" y="195" width="130" height="70" rx="12" fill="#0e1318" stroke="#2a3744"/>
      <text x="821" y="225" text-anchor="middle" font-size="13" font-weight="700" fill="#fff">Marketing tags</text>
      <text x="821" y="245" text-anchor="middle" font-size="11.5" fill="#8b98a5">ads, pixels, CRM</text>
      <rect x="756" y="295" width="130" height="70" rx="12" fill="#0e1318" stroke="#2a3744"/>
      <text x="821" y="325" text-anchor="middle" font-size="13" font-weight="700" fill="#fff">sGTM, BigQuery</text>
      <text x="821" y="345" text-anchor="middle" font-size="11.5" fill="#8b98a5">control and storage</text>
    </g>

    <!-- web team -->
    <g>
      <rect x="376" y="20" width="150" height="66" rx="12" fill="#0a0e12" stroke="#2a3744" stroke-dasharray="4 4"/>
      <text x="451" y="46" text-anchor="middle" font-size="13" font-weight="700" fill="#fff">Web team</text>
      <text x="451" y="66" text-anchor="middle" font-size="11.5" fill="#8b98a5">pushes events and values</text>
    </g>
    <!-- enrichment -->
    <g>
      <rect x="376" y="374" width="150" height="66" rx="12" fill="#0a0e12" stroke="#2a3744" stroke-dasharray="4 4"/>
      <text x="451" y="400" text-anchor="middle" font-size="13" font-weight="700" fill="#fff">Enrichment tools</text>
      <text x="451" y="420" text-anchor="middle" font-size="11.5" fill="#8b98a5">Demandbase and similar</text>
    </g>

    <!-- step badges -->
    <g font-size="11" font-weight="700" fill="#07090c" text-anchor="middle">
      <circle cx="16" cy="188" r="11" fill="#D4AF37"/><text x="16" y="192">1</text>
      <circle cx="176" cy="168" r="11" fill="#D4AF37"/><text x="176" y="172">2</text>
      <circle cx="376" cy="168" r="11" fill="#D4AF37"/><text x="376" y="172">3</text>
      <circle cx="576" cy="168" r="11" fill="#D4AF37"/><text x="576" y="172">4</text>
      <circle cx="756" cy="95" r="11" fill="#D4AF37"/><text x="756" y="99">5</text>
    </g>
  </svg>
  <figcaption>Figure 1. The tracking architecture to draw before you tag anything: visitor, consent banner, dataLayer, Google Tag Manager, then your destinations.</figcaption>
</figure>
