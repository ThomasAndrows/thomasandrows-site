---
import { NAV, SITE } from '../data/site';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const active = (href: string) => (path === href || path.startsWith(href + '/') ? 'page' : undefined);
---
<header style="position: sticky; top: 0; z-index: 50; background: rgba(7, 9, 12, 0.88); backdrop-filter: blur(12px); border-bottom: 1px solid #1c2630;">
  <div class="wrap" style="height: 64px; display: flex; align-items: center; justify-content: space-between; gap: 24px;">
    <a href="/" class="mono" aria-label="Thomas Androws, home" style="color: #e6edf3; text-decoration: none; font-size: 16px; font-weight: 500; letter-spacing: 0.02em;">{SITE.brand}<span class="cursor" style="color: #D4AF37;">_</span></a>
    <nav class="nav-links" aria-label="Main" style="display: flex; gap: 28px; align-items: center;">
      {NAV.map((l) => <a class="nav-link" href={l.href} aria-current={active(l.href)}>{l.label}</a>)}
    </nav>
    <div style="display: flex; align-items: center; gap: 12px;">
      <a class="btn-primary header-cta" href={`mailto:${SITE.email}`} style="padding: 10px 18px; font-size: 15px;">Say hello</a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-nav">Menu</button>
    </div>
  </div>
  <nav id="mobile-nav" class="mobile-nav" aria-label="Mobile">
    {NAV.map((l) => <a href={l.href}>{l.label}</a>)}
    <a href={`mailto:${SITE.email}`} style="color:#D4AF37;">Say hello</a>
  </nav>
  <div class="progress"></div>
</header>
